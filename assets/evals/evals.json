{
  "skill": "agy-image",
  "version": "2026.8.15",
  "description": "Trigger and functional cases for generic agy generation plus missing osu! storyboard assets.",
  "benchmark_metadata_required": [
    "skill_version",
    "git_commit",
    "host",
    "model",
    "temperature",
    "run_timestamp",
    "grader_version"
  ],
  "evals": [
    {
      "id": "direct-zh-agy",
      "trigger_class": "direct",
      "language": "zh",
      "coverage_tags": ["should-trigger", "agy", "happy-path"],
      "prompt": "用 WSL 裡的 agy 生一張 16:9 星空背景。",
      "expectations": [
        "selects agy-image",
        "uses explicit pixels",
        "runs the bundled wrapper inside WSL",
        "verifies the real output"
      ]
    },
    {
      "id": "osu-missing-background-zh",
      "trigger_class": "indirect",
      "language": "zh",
      "coverage_tags": ["should-trigger", "osu-storyboard", "missing-asset"],
      "prompt": "幫我寫這張圖的 osu storyboard，副歌需要一張目前素材夾沒有的霓虹城市全景。",
      "expectations": [
        "inventories existing beatmap images first",
        "selects agy-image when the required city asset is absent",
        "chooses an osu-appropriate JPEG size and relative path",
        "integrates and previews the generated asset"
      ]
    },
    {
      "id": "osu-storybrew-missing-cut-in-en",
      "trigger_class": "indirect",
      "language": "en",
      "coverage_tags": ["should-trigger", "storybrew", "foreground"],
      "prompt": "Build the storybrew chorus scene; it needs a new character cut-in that is not in the map folder.",
      "expectations": [
        "selects agy-image for the missing visual",
        "does not claim agy guarantees alpha",
        "plans PNG matting and alpha verification",
        "uses a relative beatmap path"
      ]
    },
    {
      "id": "osu-existing-assets-only",
      "trigger_class": "negative",
      "language": "en",
      "coverage_tags": ["should-not-trigger", "osu-storyboard", "reuse"],
      "prompt": "Write an osu storyboard using only the twelve images already in SB/assets; do not generate anything new.",
      "expectations": [
        "does not invoke agy",
        "reuses existing assets"
      ]
    },
    {
      "id": "osu-simple-resize",
      "trigger_class": "negative",
      "language": "zh",
      "coverage_tags": ["should-not-trigger", "image-editing", "osu-storyboard"],
      "prompt": "把現有的 SB/bg.jpg 縮成 854x480 再放進 storyboard。",
      "expectations": [
        "does not invoke agy",
        "uses an image resize workflow"
      ]
    },
    {
      "id": "reference-character-series",
      "trigger_class": "direct",
      "language": "mixed",
      "coverage_tags": ["should-trigger", "reference-lock", "series"],
      "prompt": "用 antigravity CLI 參考角色圖，為 storyboard 生三個相同角色的場景。",
      "expectations": [
        "starts with one reviewed image",
        "uses one or two references",
        "keeps subject anchor and dimensions stable"
      ]
    },
    {
      "id": "other-generator",
      "trigger_class": "negative",
      "language": "zh",
      "coverage_tags": ["should-not-trigger", "other-generator"],
      "prompt": "用 Midjourney 生一張 osu storyboard 的太空背景。",
      "expectations": [
        "does not select agy-image",
        "respects the explicitly named generator"
      ]
    },
    {
      "id": "analyze-existing",
      "trigger_class": "negative",
      "language": "en",
      "coverage_tags": ["should-not-trigger", "analysis"],
      "prompt": "Use agy to analyse the objects and text in this existing storyboard frame.",
      "expectations": [
        "does not select agy-image",
        "recognizes image analysis rather than generation"
      ]
    },
    {
      "id": "headless-permission-regression",
      "trigger_class": "functional",
      "language": "en",
      "coverage_tags": ["wrapper", "permissions", "regression"],
      "prompt": "Generate one 1024x1024 test image through agy print mode.",
      "expectations": [
        "uses --dangerously-skip-permissions with the plural spelling",
        "uses --disable-slash-commands",
        "does not recursively invoke agy-image"
      ]
    },
    {
      "id": "artifact-collection-regression",
      "trigger_class": "functional",
      "language": "en",
      "coverage_tags": ["wrapper", "artifact", "regression"],
      "prompt": "agy stores its JPEG in the brain directory rather than --out.",
      "expectations": [
        "discovers only a new or modified artifact",
        "materializes it at --out",
        "reports source_artifact and the true final format"
      ]
    }
  ]
}
